{
  "name": "O-RAN Intent MANO Development",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.24.7"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": true,
      "installDockerBuildx": true,
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.31.0",
      "helm": "3.16.2",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers-contrib/features/kind:1": {
      "version": "0.23.0"
    },
    "ghcr.io/devcontainers-contrib/features/pre-commit:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "golang.go",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "googlecloudtools.cloudcode",
        "ms-azuretools.vscode-docker",
        "hashicorp.terraform",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "github.vscode-pull-request-github",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "ms-vscode.makefile-tools",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "ruff.enable": true,
        "ruff.organizeImports": true,
        "go.gopath": "/go",
        "go.toolsManagement.autoUpdate": true,
        "go.useLanguageServer": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--fast", "--enable=gosec,gocritic,revive"],
        "gopls": {
          "ui.semanticTokens": true,
          "formatting.gofumpt": true
        },
        "editor.formatOnSave": true,
        "editor.rulers": [80, 120],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "yaml.schemas": {
          "kubernetes": ["*.yaml", "!.github/**"],
          "https://json.schemastore.org/kustomization.json": "kustomization.yaml"
        },
        "yaml.format.enable": true,
        "cSpell.enabled": true,
        "cSpell.words": [
          "MANO",
          "ORAN",
          "Nephio",
          "Porch",
          "ConfigSync",
          "Kube",
          "VXLAN",
          "GitOps",
          "CRDs",
          "kubectl",
          "kustomize",
          "devcontainer",
          "ruff",
          "golangci",
          "shellcheck",
          "hadolint",
          "yamllint",
          "markdownlint",
          "aspell",
          "O2ims",
          "O2dms"
        ]
      }
    }
  },
  "onCreateCommand": {
    "install-tools": "go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest && go install sigs.k8s.io/controller-runtime/tools/setup-envtest@latest && go install github.com/securego/gosec/v2/cmd/gosec@latest && go install sigs.k8s.io/controller-tools/cmd/controller-gen@latest && go install sigs.k8s.io/kustomize/kustomize/v5@latest",
    "install-kubebuilder": "curl -L -o /tmp/kubebuilder https://go.kubebuilder.io/dl/3.15.1/$(go env GOOS)/$(go env GOARCH) && chmod +x /tmp/kubebuilder && sudo mv /tmp/kubebuilder /usr/local/bin/kubebuilder",
    "install-system-tools": "sudo apt-get update && sudo apt-get install -y iperf3"
  },
  "postCreateCommand": "bash scripts/bootstrap.sh && pre-commit install --install-hooks",
  "postStartCommand": {
    "setup": "make verify-env",
    "git-config": "git config --global --add safe.directory /workspace"
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
    "source=devcontainer-go-mod-cache,target=/go/pkg/mod,type=volume",
    "source=devcontainer-go-build-cache,target=/home/vscode/.cache/go-build,type=volume",
    "source=devcontainer-python-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=devcontainer-extensions,target=/home/vscode/.vscode-server/extensions,type=volume"
  ],
  "runArgs": [
    "--init",
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=SYS_PTRACE",
    "--security-opt=no-new-privileges"
  ],
  "containerEnv": {
    "SHELL": "/bin/bash",
    "PYTHONPATH": "/workspace",
    "GOPATH": "/go",
    "PATH": "/workspace/scripts:/usr/local/go/bin:/go/bin:${PATH}"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
}