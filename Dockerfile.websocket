# syntax=docker/dockerfile:1.4
# Multi-stage build for O-RAN WebSocket Server

# Build arguments for customization
ARG GO_VERSION=1.23
ARG ALPINE_VERSION=3.19

FROM golang:${GO_VERSION}-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata && \
    rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies with BuildKit cache mount
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source code
COPY . .

# Build the WebSocket server with BuildKit cache mount and security flags
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -buildid= -extldflags=-static" \
    -tags=netgo \
    -a -installsuffix cgo \
    -o websocket-server ./cmd/websocket-server

# Runtime stage with metadata
FROM alpine:${ALPINE_VERSION} AS runtime

# Metadata
LABEL org.opencontainers.image.title="O-RAN WebSocket Server"
LABEL org.opencontainers.image.description="O-RAN WebSocket Server for Real-time Communication"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="O-RAN Alliance"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tmux \
    bash \
    curl \
    && rm -rf /var/cache/apk/*

# Add non-root user
RUN adduser -D -s /bin/bash claude

# Set working directory
WORKDIR /app

# Copy binary from builder with proper ownership
COPY --from=builder --chown=claude:claude /build/websocket-server .

# Copy web files with proper ownership
COPY --from=builder --chown=claude:claude /build/web ./web

# Create necessary directories
RUN mkdir -p /home/claude/.config /tmp/claude \
    && chown -R claude:claude /app /home/claude /tmp/claude

# Switch to non-root user
USER claude

# Create tmux config for optimal session management
RUN echo "set -g default-terminal \"screen-256color\"" > /home/claude/.tmux.conf && \
    echo "set -g history-limit 10000" >> /home/claude/.tmux.conf && \
    echo "set -g mouse on" >> /home/claude/.tmux.conf

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Set environment variables
ENV TMPDIR=/tmp/claude \
    HOME=/home/claude

# Start the server
ENTRYPOINT ["./websocket-server"]
CMD ["-addr", ":8080"]